# mujik-transcriptor CPU-only 镜像
# 见 docs/design.md §7
# 适用：CI、benchmark、无 GPU 机器

ARG PYTHON_VERSION=3.11
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

FROM python:${PYTHON_VERSION}-slim AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=C.UTF-8

RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && if [ -f /etc/apt/sources.list ]; then \
        sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        git \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 mujik

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

COPY --chown=mujik:mujik pyproject.toml ./
COPY --chown=mujik:mujik src ./src

USER mujik
RUN uv venv --python ${PYTHON_VERSION} .venv \
    && . .venv/bin/activate \
    && uv pip install --no-cache ".[core-io,render]"

ENV PATH="/home/mujik/.local/bin:/app/.venv/bin:${PATH}"

ENTRYPOINT ["mujik"]
CMD ["--help"]
